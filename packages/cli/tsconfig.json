{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"],
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@lpc-toolkit/core": ["../core/src/index.ts"],
      "@lpc-toolkit/presets": ["../presets/src/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
