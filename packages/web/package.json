{
  "name": "@lpc-toolkit/web",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare-assets": "tsx scripts/prepare-assets.ts",
    "materialize-upstream-test-fixtures": "tsx scripts/materialize-upstream-test-fixtures.ts",
    "verify-upstream-pin": "tsx scripts/verify-upstream-pin.ts",
    "verify-upstream-parity": "tsx scripts/verify-upstream-parity.ts",
    "zip-assets": "tsx scripts/zip-assets.ts",
    "prebuild": "pnpm prepare-assets && pnpm verify-upstream-pin && pnpm --filter @lpc-toolkit/core build && pnpm --filter @lpc-toolkit/presets build",
    "build": "vite build",
    "build:embedded": "vite build --mode embedded --outDir dist-embedded",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "copy-sprites": "tsx scripts/copy-spritesheets.ts",
    "gen-i18n": "tsx scripts/gen-i18n-data.ts",
    "pretest": "pnpm prepare-assets && pnpm verify-upstream-pin",
    "test": "vitest run",
    "pretest:e2e": "pnpm prepare-assets && pnpm verify-upstream-pin && pnpm --filter @lpc-toolkit/cli build",
    "test:e2e": "playwright test",
    "pretest:e2e:parity": "pnpm prepare-assets && pnpm verify-upstream-pin && pnpm verify-upstream-parity",
    "test:e2e:parity": "playwright test -c playwright.parity.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "audit:thumbnail-bounds": "tsx scripts/audit-thumbnail-visible-bounds.ts",
    "validate-assets": "tsx scripts/validate-assets.ts"
  },
  "dependencies": {
    "@lpc-toolkit/core": "workspace:*",
    "@lpc-toolkit/asset-pack-format": "workspace:*",
    "@lpc-toolkit/presets": "workspace:*",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "vite": "^6.0.0"
  }
}
