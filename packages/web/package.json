{
  "name": "@lpc-toolkit/web",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "zip-assets": "tsx scripts/zip-assets.ts",
    "prebuild": "pnpm --filter @lpc-toolkit/core build && tsx scripts/copy-spritesheets.ts && pnpm zip-assets",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "copy-sprites": "tsx scripts/copy-spritesheets.ts",
    "gen-i18n": "tsx scripts/gen-i18n-data.ts",
    "pretest": "tsx scripts/copy-spritesheets.ts && pnpm zip-assets",
    "test": "vitest run",
    "pretest:e2e": "tsx scripts/copy-spritesheets.ts && pnpm zip-assets",
    "test:e2e": "playwright test",
    "pretest:e2e:parity": "tsx scripts/copy-spritesheets.ts && pnpm zip-assets",
    "test:e2e:parity": "playwright test -c playwright.parity.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@lpc-toolkit/core": "workspace:*",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "vite": "^6.0.0"
  }
}
