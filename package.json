{
  "name": "lpc-toolkit",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo: shared core for composing LPC character sprites + React web UI + CLI",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "pretest": "pnpm --filter @lpc-toolkit/web prepare-assets",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "typescript": "~5.7.0",
    "vitest": "^2.1.0"
  }
}
